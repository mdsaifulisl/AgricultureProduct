# এই নমুনায় আসল secret দেবেন না; production values server/.env বা host-এর secret manager-এ রাখুন।
PORT=5000
DATABASE_URL="postgresql://USER:PASSWORD@DB_HOST:5432/DATABASE?schema=public"
DB_POOL_SIZE=5
DB_POOL_TIMEOUT=20

JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CLIENT_URL=https://reliablekrishi.com
CORS_ORIGINS=https://reliablekrishi.com

# shared hosting-এ Redis না থাকলে একটি worker-এই চালান।
WEB_CONCURRENCY=1

# Redis provision করলে তবেই এই URL দিন এবং worker বাড়ান।
# REDIS_URL=rediss://USER:PASSWORD@REDIS_HOST:PORT

# Reverse proxy topology নিশ্চিত করে hop count দিন; অনুমান করে সেট করবেন না।
# TRUST_PROXY_HOPS=1

ENABLE_STATUS_MONITOR=false
