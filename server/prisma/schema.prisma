generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//USERS 

enum Role {
  admin
  moderator
  writer
}

enum UserStatus {
  active
  inactive
}

model User {
  id       String     @id @default(uuid())
  name     String
  email    String     @unique
  phone    String?
  password String
  role     Role       @default(writer)
  status   UserStatus @default(active)

  // Forgot Password OTP handling
  resetOtp          String?
  resetOtpExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Product

model Product {
  id                 String          @id @default(uuid())
  name               String
  category           String
  categorySlug       String
  price              Float
  originalPrice      Float?
  unit               String
  rating             Float           @default(0)
  reviewsCount       Int             @default(0)
  images             String[]
  description        String
  shortDescription   String
  metaDescription    String?
  badge              String?
  inStock            Boolean         @default(true)
  stockCount         Int             @default(0)
  sku                String          @unique
  isFeatured         Boolean         @default(false)
  specifications     Specification[]
  tags               String[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@map("products")
}

model Specification {
  id        String  @id @default(uuid())
  key       String
  value     String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("specifications")
}

//End product

//order
enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id                String      @id @default(uuid())
  trackingId        String      @unique
  fullName          String
  phone             String
  address           String
  note              String?
  paymentMethod     String      @default("COD")
  deliveryFee       Float
  totalAmount       Float
  status            OrderStatus @default(PENDING)
  seenName          String      @default("unSeen")
  ipAddress         String? // গ্রাহকের IP লগ
  deviceFingerprint String?
  shippingZone      String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items OrderItem[]

  @@index([deviceFingerprint])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  productId  String
  name       String
  price      Float
  image      String
  unit       String?
  baseAmount Float?
  sku        String?
  quantity   Float

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

// Catagory
model Category {
  id          String   @id @default(uuid())
  name        String
  image       String
  description String
  badge       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categorys")
}

// slider 

enum SlideStatus {
  active
  inactive
}

model HeroSlide {
  id               String      @id @default(uuid())
  badge            String?
  title            String
  highlightText    String?
  description      String?
  primaryBtnText   String?
  primaryBtnLink   String?
  secondaryBtnText String?
  secondaryBtnLink String?
  image            String
  imageAlt         String?
  tag              String?
  status           SlideStatus @default(active)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@map("hero_slides")
}

// Video

enum Status {
  active
  inactive
}

model Video {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  youtubeId   String
  category    String?
  duration    String?
  views       String?
  featured    Boolean  @default(false)
  status      Status   @default(active)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("videos")
}

// Blogs

enum BlogStatus {
  published
  draft
  archived
}

model BlogPost {
  id              String        @id @default(uuid())
  title           String
  metaDescription String?
  content         String        @db.Text // HTML এবং Image tag ধারণ করার জন্য Text type
  category        String
  author          String
  authorRole      String?
  date            String
  readTime        String
  image           String
  tags            String[]
  likes           Int           @default(0)
  status          BlogStatus    @default(published)
  comments        BlogComment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model BlogComment {
  id          String   @id @default(uuid())
  userName    String
  commentText String
  blogId      String
  blogPost    BlogPost @relation(fields: [blogId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

//end blog 

//partners
model Partner {
  id         String   @id @default(uuid())
  name       String
  logo       String
  websiteUrl String?  @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("partners")
}

// SiteSetting

model SiteSetting {
  id                      String   @id @default(uuid())
  siteLogo                String?  @db.Text
  siteFavicon             String?  @db.Text
  siteTitle               String   @default("কৃষি শপ - বিশ্বস্ত অর্গানিক কৃষি পণ্য ও সরঞ্জাম")
  siteDescription         String?  @db.Text
  metaKeywords            String?  @db.Text
  contactPhone            String?
  contactEmail            String?
  facebookUrl             String?
  youtubeUrl              String?
  tiktokUrl               String?
  instagramUrl            String?
  linkedinUrl             String?
  telegramBotToken        String?
  telegramChatId          String?
  insideDhakaDeliveryFee  Float?   @default(60)
  outsideDhakaDeliveryFee Float?   @default(120)
  updatedAt               DateTime @updatedAt
  createdAt               DateTime @default(now())

  @@map("site_settings")
}

//About setting 

model AboutSetting {
  id            String   @id @default(uuid())
  imageUrl      String?
  badgeTitle    String   @default("সেরা কৃষি ই-কমার্স")
  badgeSubtitle String   @default("গ্রাহক সন্তুষ্টি ও নির্ভরযোগ্যতায়")
  tagline       String   @default("আমাদের মূল লক্ষ্য")
  title         String   @default("আমরা কীভাবে বাজারে একটি ইতিবাচক পরিবর্তন আনছি?")
  description   String   @db.Text
  features      String[] // Array of strings (PostgreSQL / MySQL JSON/Array support)
  buttonText    String   @default("পণ্যসমূহ দেখুন")
  buttonLink    String   @default("/shop")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ip block 

model IpLog {
  id        String   @id @default(uuid())
  ip        String   @unique
  fullName  String?
  phone     String?
  isBlocked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeviceBlock {
  id          String   @id @default(uuid())
  fingerprint String   @unique
  reason      String?  @db.VarChar(300)
  isBlocked   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("device_blocks")
}
